<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_stepby_step_screen"
    android:fillViewport="true"
    tools:context=".MainActivity"
    tools:ignore="VisualLintBounds,TextContrast">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        tools:ignore="VisualLintBounds,VisualLintOverlap">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:layout_marginBottom="22dp"
            tools:ignore="VisualLintBounds,VisualLintOverlap">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_title"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    tools:ignore="VisualLintBounds,VisualLintOverlap"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvSessionTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/initial_time"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/brand_600"
                android:background="@drawable/bg_timer"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                tools:ignore="VisualLintBounds,VisualLintOverlap"/>

        </LinearLayout>

        <!-- ================= CURRENT SESSION ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp">

            <!-- SESSION HEADER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/current_session"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_600"/>

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_status_dot"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_status"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginStart="5dp"/>

            </LinearLayout>

            <!-- STEP AND SHAKE CARDS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">


                <!-- STEP CARD -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="210dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_step_tile"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/icon_steps"
                        android:textSize="30sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/steps"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_muted"/>

                    <TextView
                        android:id="@+id/tvSteps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zero_value"
                        android:textSize="46sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_count"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>

                </LinearLayout>

                <!-- SHAKE CARD -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="210dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_shake_tile"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/icon_shakes"
                        android:textSize="30sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shakes"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_muted"/>

                    <TextView
                        android:id="@+id/tvShakes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zero_value"
                        android:textSize="46sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shake_count"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvStepRecord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:background="@drawable/bg_badge_step"
                android:text="@string/new_step_record"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvShakeRecord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:background="@drawable/bg_badge_shake"
                android:text="@string/new_shake_record"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite"
                tools:visibility="visible" />

            <!-- SESSION STATISTICS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:baselineAligned="false"
                android:background="@drawable/bg_summary"
                android:paddingVertical="15dp"
                android:layout_marginTop="18dp">

                <!-- DURATION -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/tvDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/initial_time"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="42dp"
                    android:background="@color/history_divider"/>

                <!-- STEPS PER MINUTE -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/steps_per_minute"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/tvStepsPerMinute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zero_rate"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_600"/>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="42dp"
                    android:background="@color/history_divider"/>

                <!-- SHAKES PER MINUTE -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shakes_per_minute"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/tvShakePerMinute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zero_rate"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/shake_primary"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ================= TOTAL SUMMARY ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/brand_100"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/overall_total"
                android:textColor="@color/badge_total_text"
                android:textSize="12sp"
                android:textStyle="bold" />


            <!-- TOTAL COUNTS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:baselineAligned="false"
                android:padding="15dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_summary">

                <TextView
                    android:id="@+id/tvTotalSteps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/initial_total_steps"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_600"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="@color/history_divider"/>

                <TextView
                    android:id="@+id/tvTotalShakes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/initial_total_shakes"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/shake_primary"/>

            </LinearLayout>

            <!-- SAVE BUTTON -->

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_height="60dp"
                android:layout_marginTop="18dp"
                android:text="@string/save_activity"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:background="@drawable/bg_primary_button"
                android:backgroundTint="@null"
                android:elevation="3dp"
                tools:ignore="VisualLintButtonSize"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnResetSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/reset_session"
            android:textAllCaps="false" />

        <!-- ================= SENSOR STATUS ================= -->

        <TextView
            android:id="@+id/tvSensorStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sensor_waiting"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:padding="10dp"
            tools:ignore="TextContrast"/>

        <!-- ================= HISTORY HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_history"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvHistoryEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                tools:ignore="TextContrast"/>

        </LinearLayout>

        <!-- HISTORY CONTAINER -->

    <TextView
        android:id="@+id/tvHistoryEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_history_item"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/history_empty"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:visibility="gone" />
    </LinearLayout>
</ScrollView>